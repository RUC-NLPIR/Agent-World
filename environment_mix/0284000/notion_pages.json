  "49562ce9-53fe-5466-8c31-4d7fb2b392c3": {
    "id": "49562ce9-53fe-5466-8c31-4d7fb2b392c3",
    "title": "8D Report: lot-240309 cracking",
    "blocks": [
      {
        "type": "heading_1",
        "text": "8D Report - lot-240309 cracking (7.1%)"
      },
      {
        "type": "heading_2",
        "text": "D1 - Team"
      },
      {
        "type": "paragraph",
        "text": "chen.jie (QC lead), guo.tao (mfg), tang.rui (production)."
      },
      {
        "type": "heading_2",
        "text": "D2 - Problem"
      },
      {
        "type": "paragraph",
        "text": "Lot-240309 cracking at 7.1%, concentrated on press-7 output 03-19 to 03-22."
      },
      {
        "type": "heading_2",
        "text": "D3 - Interim containment"
      },
      {
        "type": "paragraph",
        "text": "100% sort of 240309 + 240313; quarantined sub-batches."
      },
      {
        "type": "heading_2",
        "text": "D4 - Root cause"
      },
      {
        "type": "paragraph",
        "text": "Press-7 tonnage sensor PS-7 fault caused -8% drift undetected from 03-19."
      },
      {
        "type": "heading_2",
        "text": "D5 - Permanent corrective"
      },
      {
        "type": "paragraph",
        "text": "Sensor replaced 03-23 PM; PS-7 check added to daily press checklist."
      },
      {
        "type": "heading_2",
        "text": "D6 - Verification"
      },
      {
        "type": "paragraph",
        "text": "240309 yield restored to 98.9%; supplier not implicated."
      },
      {
        "type": "heading_2",
        "text": "D7 - Prevention"
      },
      {
        "type": "paragraph",
        "text": "Predictive sensor maintenance interval reduced 90->60 days."
      },
      {
        "type": "heading_2",
        "text": "D8 - Close"
      },
      {
        "type": "paragraph",
        "text": "Closed 2024-03-27. CAPA-2024-015."
      }
    ],
    "parent": {
      "type": "database_id",
      "database_id": "db_defects"
    }
  },
