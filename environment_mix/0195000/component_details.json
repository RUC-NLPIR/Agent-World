    "revision": 3,
    "description_md": "# Dropdown Menu\nMenu anchored to a trigger for compact actions. Supports submenus, checkbox/radio items, and keyboard navigation via Radix.",
    "installation_md": "```bash\npnpm add @radix-ui/react-dropdown-menu\n```",
    "usage_md": "For icon-only triggers, add `aria-label`. Avoid putting destructive actions next to common actions; separate with a separator for clarity.",
    "props_schema": {
      "DropdownMenuContent": {
        "props": [
          {
            "name": "side",
            "type": "\"top\"|\"right\"|\"bottom\"|\"left\"",
            "default": "\"bottom\"",
            "description": "Preferred side for placement."
          },
          {
            "name": "align",
            "type": "\"start\"|\"center\"|\"end\"",
            "default": "\"start\"",
            "description": "Alignment relative to trigger."
          },
          {
            "name": "sideOffset",
            "type": "number",
            "default": "4",
            "description": "Offset in pixels."
          }
        ]
      },
      "DropdownMenuItem": {
        "props": [
          {
            "name": "inset",
