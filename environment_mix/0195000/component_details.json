    "usage_md": "Set `AvatarImage` `alt` to the user name. Use `AvatarFallback` with initials and a short delay to avoid flash of fallback on slow networks.",
    "props_schema": {
      "AvatarImage": {
        "props": [
          {
            "name": "src",
            "type": "string",
            "default": null,
            "description": "Image URL."
          },
          {
            "name": "alt",
            "type": "string",
            "default": null,
            "description": "Alternative text for screen readers."
          }
        ]
      },
      "AvatarFallback": {
        "props": [
          {
            "name": "delayMs",
            "type": "number",
            "default": "0",
            "description": "Delay before showing fallback."
          }
        ]
      }
    },
    "dependencies": [
      "@radix-ui/react-avatar",
