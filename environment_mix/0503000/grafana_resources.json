  {
    "id": "gfr_01J9Q270N5M8V1D6C2H9S4W7TX",
    "instance_id": "gfi_01J7R5KQ7X9A3B8N5V7C6H1Q2R",
    "resource_type": "alert_rule",
    "uid": "ar_db_conn_exhaust",
    "numeric_id": 920,
    "name": null,
    "title": "DB connection pool exhaustion",
    "folder_uid": "fld_platform",
    "folder_title": "Platform",
    "type": null,
    "url": "https://grafana.labs.ember.example/alerting/grafana/ar_db_conn_exhaust/view",
    "tags": [],
    "labels": {
      "env": "prod",
      "team": "platform",
      "service": "postgres",
      "severity": "page"
    },
    "is_default": false,
    "state": "firing",
    "spec": {
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "ds_prom_labs",
          "model": {
            "expr": "max(pg_stat_activity_count{datname=~\"app_.*\"}) / max(pg_settings_max_connections)",
            "interval": "30s"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "op": "gt",
            "value": 0.85
          }
        }
      ],
      "for": "2m",
      "noDataState": "NoData",
      "execErrState": "Error"
    },
    "spec_etag": "W/\"ar:ar_db_conn_exhaust:v2\"",
    "last_synced_at": "2026-07-30T03:48:51Z",
    "status": "active",
    "created_at": "2026-07-02T23:16:09Z",
