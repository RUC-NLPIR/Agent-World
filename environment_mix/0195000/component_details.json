  {
    "id": "shc_det_01HVD4A2R9C6M1T8K3P7N0Q5BX",
    "component_id": "shc_cmp_01HVD1N9KX0Q7D1E3R8M2T6A9B",
    "revision": 1,
    "description_md": "# Accordion\nAccessible disclosure UI built on Radix Accordion. Supports single/multiple items, keyboard navigation, and smooth transitions.\n\nUse for FAQs, settings groups, and progressive disclosure.",
    "installation_md": "```bash\npnpm add @radix-ui/react-accordion\n```\nThen add the component file from shadcn/ui.",
    "usage_md": "Use `type=\"single\"` for one open item. Add `collapsible` to allow closing the last item. Keep triggers as buttons for a11y.",
    "props_schema": {
      "Accordion": {
        "props": [
          {
            "name": "type",
            "type": "\"single\" | \"multiple\"",
            "default": "\"single\"",
            "description": "Selection mode."
          },
          {
            "name": "collapsible",
            "type": "boolean",
            "default": "false",
            "description": "Allow closing the active item (single mode)."
          },
          {
            "name": "defaultValue",
            "type": "string | string[]",
            "default": null,
            "description": "Uncontrolled initial open item(s)."
          }
        ]
      },
      "AccordionItem": {
        "props": [
          {
            "name": "value",
            "type": "string",
            "default": null,
            "description": "Unique item identifier."
          },
          {
            "name": "disabled",
            "type": "boolean",
            "default": "false",
            "description": "Disable interactions for this item."
          }
        ]
      },
      "AccordionTrigger": {
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "default": "false",
            "description": "Use a custom trigger element via Slot."
          }
        ]
      },
      "AccordionContent": {
        "props": [
          {
            "name": "forceMount",
            "type": "boolean",
            "default": "false",
            "description": "Keep content mounted for animations/measuring."
          }
        ]
      }
    },
    "dependencies": [
      "@radix-ui/react-accordion",
      "class-variance-authority",
      "clsx",
      "tailwind-merge"
    ],
    "status": "active",
    "created_at": "2025-01-08T14:22:37Z",
    "updated_at": "2025-04-03T09:41:12Z"
  },
  {
    "id": "shc_det_01HVD4B8W2Q7A9M0D6K3T1V5RC",
    "component_id": "shc_cmp_01HVD1Q3C2M8P9J7W4F6A1K0XQ",
    "revision": 2,
    "description_md": "# Alert Dialog\nModal confirmation dialog for destructive or high-impact actions. Focus is trapped and restored on close; escape and overlay click supported.",
    "installation_md": "```bash\npnpm add @radix-ui/react-alert-dialog\n```\nAdd `alert-dialog.tsx` from shadcn/ui and ensure Tailwind is set up.",
    "usage_md": "Use for irreversible actions (delete, revoke). Keep title/description meaningful. Put the destructive action last and style it clearly.",
    "props_schema": {
      "AlertDialog": {
        "props": [
          {
            "name": "open",
            "type": "boolean",
            "default": null,
            "description": "Controlled open state."
          },
          {
            "name": "defaultOpen",
            "type": "boolean",
            "default": "false",
            "description": "Uncontrolled initial open state."
          },
          {
            "name": "onOpenChange",
            "type": "(open: boolean) => void",
            "default": null,
            "description": "Called when open state changes."
          }
        ]
      },
      "AlertDialogAction": {
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "default": "false",
            "description": "Wrap a custom button element."
          }
        ]
      },
      "AlertDialogCancel": {
        "props": [
          {
            "name": "asChild",
            "type": "boolean",
            "default": "false",
            "description": "Wrap a custom button element."
          }
        ]
      }
    },
    "dependencies": [
      "@radix-ui/react-alert-dialog",
      "clsx",
      "tailwind-merge"
    ],
    "status": "active",
    "created_at": "2025-02-19T11:06:53Z",
    "updated_at": "2025-05-11T18:27:09Z"
  },
