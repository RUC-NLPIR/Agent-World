                  "lot",
                  "line",
                  "defect_rate",
                  "cracking_pct",
                  "status",
                  "inspector",
                  "date",
                  "supplier",
                  "root_cause"
                ],
                [
                  "lot-240302",
                  "Line 2",
                  "4.2%",
                  "3.8%",
                  "escalated",
                  "chen.jie",
                  "2024-03-19",
                  "PartsCo",
                  "tooling drift"
                ],
                [
                  "lot-240305",
                  "Line 2",
                  "5.6%",
                  "2.0%",
                  "escalated",
                  "chen.jie",
                  "2024-03-20",
                  "PartsCo",
                  "press tonnage"
                ]
              ]
            }
          },
          {
            "tool": "find_row",
            "args": {
              "sheet_id": "sheet_capa",
              "worksheet": "Sheet1",
              "column": "lot",
              "value": "lot-240302"
            }
          },
          {
            "tool": "find_row",
            "args": {
              "sheet_id": "sheet_capa",
