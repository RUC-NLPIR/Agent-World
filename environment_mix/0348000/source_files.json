    "content": "use crate::error::Error;\n\npub struct Client {\n    base: String,\n}\n\nimpl Client {\n    pub fn new(base: impl Into<String>) -> Self { Self { base: base.into() } }\n\n    pub fn base_url(&self) -> &str { &self.base }\n\n    pub fn build_url(&self, path: &str) -> Result<String, Error> {\n        if path.starts_with(\"/\") { return Err(Error::InvalidPath); }\n        Ok(format!(\"{}/{}\", self.base.trim_end_matches('/'), path))\n    }\n}\n",
