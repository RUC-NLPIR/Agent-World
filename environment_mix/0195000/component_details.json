    "revision": 1,
    "description_md": "# Calendar\nDate picker building block using `react-day-picker`. Includes styles for range selection, disabled days, and outside month days.",
    "installation_md": "```bash\npnpm add react-day-picker date-fns\n```\nEnsure Tailwind styles are included for `day-picker` classes.",
    "usage_md": "For forms, store dates as ISO strings in state and convert to `Date` for rendering. Use `disabled` to block past dates or blackout ranges.",
    "props_schema": {
      "Calendar": {
        "props": [
          {
            "name": "mode",
            "type": "\"single\" | \"range\" | \"multiple\"",
            "default": "\"single\"",
            "description": "Selection mode passed to DayPicker."
          },
          {
            "name": "selected",
            "type": "Date | DateRange | Date[]",
            "default": null,
            "description": "Selected value(s)."
          },
          {
            "name": "onSelect",
            "type": "(...args: any[]) => void",
            "default": null,
            "description": "Selection callback from DayPicker."
          },
          {
            "name": "disabled",
            "type": "Matcher | Matcher[]",
            "default": null,
            "description": "Disable certain days."
          }
        ]
      }
    },
    "dependencies": [
      "react-day-picker",
      "date-fns",
      "clsx",
      "tailwind-merge"
    ],
    "status": "active",
    "created_at": "2025-02-05T09:12:26Z",
    "updated_at": "2025-06-29T12:08:40Z"
