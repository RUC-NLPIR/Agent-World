  {
    "id": "hn_itm_01J9J2B9Q1S6A8V0M3C7K2D5R9",
    "hn_item_id": 41473240,
    "item_type": "comment",
    "status": "active",
    "title": null,
    "text": "Litestream is great until you hit large WAL churn. We capped checkpoint size and it stabilized.",
    "url": null,
    "score": null,
    "descendants": null,
    "author_user_id": "hn_usr_01J4Y9ZC9J4D2X6A7V1K0N8R3S",
