[
  {
    "id": "imgmeta_01J2S6H8G0K9Y2WZ6V9H3X8Q4R",
    "service_name": "PhotonForge Image API",
    "repository_url": "https://github.com/photonforge/image-api",
    "description_markdown": "# PhotonForge Image API\n\nGenerate images from text prompts.\n\n## Tools\n- `generate_image`: submit a job and poll status.\n- `use_description`: returns this document.\n\n## Auth\nSend `Authorization: Bearer <api_key>`.\n\n## Notes\n- `requested_image_count` 1–10.\n- Succeeded jobs always have outputs with non-empty `stored_uri`.",
    "tool_surface": {
      "tools": [
        {
          "name": "use_description",
          "path": "/v1/description",
          "method": "GET",
          "auth": "optional",
          "response": "service_metadata"
        },
        {
          "name": "generate_image",
          "path": "/v1/images:generate",
          "method": "POST",
          "auth": "required",
          "idempotency": "Idempotency-Key header or idempotency_key field",
          "request_schema": {
            "prompt": "string",
            "model": "string",
            "size": "1024x1024|1024x1536|1536x1024",
            "requested_image_count": "integer 1-10",
            "seed": "integer?",
            "negative_prompt": "string?",
            "style_preset": "string?",
            "safety": "standard|strict",
            "response_format": "json|b64_json"
          },
          "response": "image_generation_job"
        }
      ],
      "webhooks": [
        {
          "name": "job.completed",
          "enabled": true,
          "payload": "job + generated_images"
        }
      ],
      "rate_limits": {
        "default_rpm": 600,
        "burst": 60
      }
    },
    "status": "published",
    "published_at": "2026-06-18T14:22:51Z",
    "created_at": "2026-06-18T13:47:09Z",
    "updated_at": "2026-07-29T09:11:03Z"
  },
