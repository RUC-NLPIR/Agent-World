                "type": "string"
              },
              "html_url": {
                "type": "string",
                "format": "uri"
              },
              "stargazers_count": {
                "type": "integer"
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "full_name",
              "html_url",
              "stargazers_count"
            ]
          }
        },
        "total": {
          "type": "integer"
        }
      },
      "required": [
        "items",
        "total"
      ]
    },
    "is_enabled": true,
    "status": "active",
    "created_at": "2026-02-11T09:18:42Z",
