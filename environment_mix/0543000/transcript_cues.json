[
  {
    "id": "ytc_01JH0K7S9M2D8V4Q1R6T3A5B7C",
    "transcript_id": "ytt_01J9Y8W1H9V7K3D6Q2M5R8T1AX",
    "seq": 1,
    "start_seconds": 0.2,
    "duration_seconds": 3.6,
    "text": "Hey everyone, welcome back to the channel.",
    "created_at": "2026-02-06T14:12:33Z",
    "updated_at": "2026-02-06T14:12:33Z"
  },
  {
    "id": "ytc_01JH0K8A4D6M1V7Q2R9T3B5C8D",
    "transcript_id": "ytt_01J9Y8W1H9V7K3D6Q2M5R8T1AX",
    "seq": 2,
    "start_seconds": 3.9,
    "duration_seconds": 4.1,
    "text": "Today we're looking at a quick workflow you can copy.",
    "created_at": "2026-02-06T14:12:34Z",
    "updated_at": "2026-02-06T14:12:34Z"
  },
  {
    "id": "ytc_01JH0K8J2S7H3D9M5Q1R6T8C0E",
    "transcript_id": "ytt_01J9Y8W1H9V7K3D6Q2M5R8T1AX",
    "seq": 3,
    "start_seconds": 8.2,
    "duration_seconds": 4.8,
    "text": "We'll start from a clean repo and ship a small fix.",
    "created_at": "2026-02-06T14:12:34Z",
    "updated_at": "2026-02-06T14:12:34Z"
  },
  {
    "id": "ytc_01JH0K8R1P5Q9V2D6M8T3A7C1F",
    "transcript_id": "ytt_01J9Y8W1H9V7K3D6Q2M5R8T1AX",
    "seq": 4,
    "start_seconds": 13.4,
    "duration_seconds": 5.2,
    "text": "If you're new here, the links are in the description.",
    "created_at": "2026-02-06T14:12:35Z",
    "updated_at": "2026-02-06T14:12:35Z"
  },
  {
    "id": "ytc_01JH0K8Y6H2M7Q1D4V9T3A8C2G",
    "transcript_id": "ytt_01J9Y8W1H9V7K3D6Q2M5R8T1AX",
    "seq": 5,
    "start_seconds": 18.9,
    "duration_seconds": 3.9,
    "text": "Alright, let's jump into the demo.",
    "created_at": "2026-02-06T14:12:35Z",
    "updated_at": "2026-02-06T14:12:35Z"
  },
  {
    "id": "ytc_01JH1B1D6Q2M8V4H9R5T1A3C6H",
    "transcript_id": "ytt_01J9Y8X4D2M7Q1V8H3K6S9P0BN",
    "seq": 1,
    "start_seconds": 0,
    "duration_seconds": 2.7,
    "text": "In this video I'll explain what a vector index actually stores.",
    "created_at": "2026-03-18T09:44:12Z",
    "updated_at": "2026-03-18T09:44:12Z"
  },
  {
    "id": "ytc_01JH1B1M7S3H9D1V6Q2R8T4C7J",
    "transcript_id": "ytt_01J9Y8X4D2M7Q1V8H3K6S9P0BN",
    "seq": 2,
    "start_seconds": 2.9,
    "duration_seconds": 4.3,
    "text": "Think of it as a fast lookup over embeddings, not magic.",
    "created_at": "2026-03-18T09:44:13Z",
    "updated_at": "2026-03-18T09:44:13Z"
  },
  {
    "id": "ytc_01JH1B1V2P8Q4D6M9R3T7A0C8K",
    "transcript_id": "ytt_01J9Y8X4D2M7Q1V8H3K6S9P0BN",
    "seq": 3,
    "start_seconds": 7.4,
    "duration_seconds": 5.0,
    "text": "We'll cover cosine distance, metadata filters, and updates.",
    "created_at": "2026-03-18T09:44:13Z",
    "updated_at": "2026-03-18T09:44:13Z"
  },
  {
    "id": "ytc_01JH1B22H9M5Q1D7V3R8T2C9L",
    "transcript_id": "ytt_01J9Y8X4D2M7Q1V8H3K6S9P0BN",
    "seq": 4,
    "start_seconds": 12.7,
    "duration_seconds": 3.5,
    "text": "Then I'll show a small example with PostgreSQL + pgvector.",
    "created_at": "2026-03-18T09:44:14Z",
    "updated_at": "2026-03-18T09:44:14Z"
  },
  {
    "id": "ytc_01JH1B29D1M6Q3V8H2R7T0C1M",
    "transcript_id": "ytt_01J9Y8X4D2M7Q1V8H3K6S9P0BN",
    "seq": 5,
    "start_seconds": 16.4,
    "duration_seconds": 4.6,
    "text": "One caveat: indexing strategy changes with your workload.",
    "created_at": "2026-03-18T09:44:14Z",
    "updated_at": "2026-03-18T09:44:14Z"
  },
  {
    "id": "ytc_01JH2C4Q7S1H6D3V9R2T5A8C0N",
    "transcript_id": "ytt_01J9Y8Z0Q6S2H8D4M1K7V3A9CJ",
    "seq": 1,
    "start_seconds": 0.6,
    "duration_seconds": 3.2,
    "text": "So, the build failed because of a missing OpenSSL header.",
    "created_at": "2026-01-27T21:08:49Z",
    "updated_at": "2026-01-27T21:08:49Z"
  },
  {
    "id": "ytc_01JH2C4Y2M8Q1D6V3R7T9A1C2P",
    "transcript_id": "ytt_01J9Y8Z0Q6S2H8D4M1K7V3A9CJ",
    "seq": 2,
    "start_seconds": 3.9,
    "duration_seconds": 4.9,
    "text": "If you're on Ubuntu, install libssl-dev and rerun cmake.",
    "created_at": "2026-01-27T21:08:50Z",
    "updated_at": "2026-01-27T21:08:50Z"
  },
  {
    "id": "ytc_01JH2C56H9M6Q2D7V1R8T3A4C5Q",
    "transcript_id": "ytt_01J9Y8Z0Q6S2H8D4M1K7V3A9CJ",
    "seq": 3,
    "start_seconds": 9.1,
    "duration_seconds": 3.8,
    "text": "On macOS, brew install openssl and point CMAKE_PREFIX_PATH.",
    "created_at": "2026-01-27T21:08:50Z",
    "updated_at": "2026-01-27T21:08:50Z"
  },
  {
    "id": "ytc_01JH2C5E3S7H2D9M5R1T6A8C6R",
    "transcript_id": "ytt_01J9Y8Z0Q6S2H8D4M1K7V3A9CJ",
    "seq": 4,
    "start_seconds": 13.1,
    "duration_seconds": 4.4,
    "text": "Now let's confirm the compiler is picking up the right include.",
    "created_at": "2026-01-27T21:08:51Z",
    "updated_at": "2026-01-27T21:08:51Z"
  },
  {
    "id": "ytc_01JH2C5M4D1M7Q3V9R2T5A0C7S",
    "transcript_id": "ytt_01J9Y8Z0Q6S2H8D4M1K7V3A9CJ",
    "seq": 5,
    "start_seconds": 17.8,
    "duration_seconds": 3.1,
    "text": "Great—once this passes, the CI job should go green again.",
    "created_at": "2026-01-27T21:08:51Z",
    "updated_at": "2026-01-27T21:08:51Z"
  },
  {
    "id": "ytc_01JH3D7K2S8H1D6M9R3T7A0C8T",
    "transcript_id": "ytt_01J9Y95A8D1M6Q3V9H7K2S0P4RU",
    "seq": 1,
    "start_seconds": 0.1,
    "duration_seconds": 3.0,
    "text": "Let's review the quarterly results and what changed in guidance.",
    "created_at": "2025-12-11T16:26:05Z",
    "updated_at": "2025-12-11T16:26:05Z"
  },
  {
    "id": "ytc_01JH3D7S9M2D8V4Q1R6T3A5C9U",
    "transcript_id": "ytt_01J9Y95A8D1M6Q3V9H7K2S0P4RU",
    "seq": 2,
    "start_seconds": 3.3,
    "duration_seconds": 4.2,
    "text": "Revenue was up mid-single digits, driven by enterprise renewals.",
    "created_at": "2025-12-11T16:26:06Z",
    "updated_at": "2025-12-11T16:26:06Z"
  },
  {
    "id": "ytc_01JH3D80D6M1V7Q2R9T3B5D0V",
    "transcript_id": "ytt_01J9Y95A8D1M6Q3V9H7K2S0P4RU",
    "seq": 3,
    "start_seconds": 7.9,
    "duration_seconds": 3.7,
    "text": "Margins improved after the data center footprint consolidation.",
    "created_at": "2025-12-11T16:26:06Z",
    "updated_at": "2025-12-11T16:26:06Z"
  },
  {
    "id": "ytc_01JH3D88H9M5Q1D7V3R8T2C1W",
    "transcript_id": "ytt_01J9Y95A8D1M6Q3V9H7K2S0P4RU",
    "seq": 4,
    "start_seconds": 11.9,
    "duration_seconds": 4.9,
    "text": "We'll take questions at the end; please keep them to one topic.",
    "created_at": "2025-12-11T16:26:07Z",
    "updated_at": "2025-12-11T16:26:07Z"
  },
  {
    "id": "ytc_01JH3D8H3S7H2D9M5R1T6A2C2X",
    "transcript_id": "ytt_01J9Y95A8D1M6Q3V9H7K2S0P4RU",
    "seq": 5,
    "start_seconds": 17.1,
    "duration_seconds": null,
    "text": "First, let's start with the highlights slide.",
    "created_at": "2025-12-11T16:26:07Z",
    "updated_at": "2025-12-11T16:26:09Z"
  },
  {
    "id": "ytc_01JH4E9M6Q2D8V4H9R5T1A3C3Y",
    "transcript_id": "ytt_01J9Y9C9D1M7Q3V9H2K6S0P5LW",
    "seq": 1,
    "start_seconds": 0.4,
    "duration_seconds": 2.6,
    "text": "We're going to debug a flaky test in GitHub Actions.",
    "created_at": "2026-04-22T11:03:28Z",
    "updated_at": "2026-04-22T11:03:28Z"
  },
  {
    "id": "ytc_01JH4EA3P8Q4D6M9R3T7A0C4Z",
    "transcript_id": "ytt_01J9Y9C9D1M7Q3V9H2K6S0P5LW",
    "seq": 2,
    "start_seconds": 3.2,
    "duration_seconds": 4.7,
    "text": "The hint is in the logs: it fails only on the windows runner.",
    "created_at": "2026-04-22T11:03:29Z",
    "updated_at": "2026-04-22T11:03:29Z"
  },
  {
    "id": "ytc_01JH4EAB1H9M6Q2D7V1R8T3C5A",
    "transcript_id": "ytt_01J9Y9C9D1M7Q3V9H2K6S0P5LW",
    "seq": 3,
    "start_seconds": 8.2,
    "duration_seconds": 5.4,
    "text": "We'll pin the node version and add a retry for the install step.",
    "created_at": "2026-04-22T11:03:29Z",
    "updated_at": "2026-04-22T11:03:29Z"
  },
  {
    "id": "ytc_01JH4EAJ7S1H6D3V9R2T5A8C6B",
    "transcript_id": "ytt_01J9Y9C9D1M7Q3V9H2K6S0P5LW",
    "seq": 4,
    "start_seconds": 14.0,
    "duration_seconds": 3.2,
    "text": "After that, we'll make the test deterministic by seeding RNG.",
    "created_at": "2026-04-22T11:03:30Z",
    "updated_at": "2026-04-22T11:03:30Z"
  },
  {
    "id": "ytc_01JH4EAR2M8Q1D6V3R7T9A1C7C",
    "transcript_id": "ytt_01J9Y9C9D1M7Q3V9H2K6S0P5LW",
    "seq": 5,
    "start_seconds": 17.5,
    "duration_seconds": 4.1,
    "text": "Finally, we'll confirm it passes on a matrix of OS versions.",
    "created_at": "2026-04-22T11:03:30Z",
    "updated_at": "2026-04-22T11:03:30Z"
  },
  {
    "id": "ytc_01JH5F1V6H2S9K1D5R8T3A7C8D",
    "transcript_id": "ytt_01J9Y9E0K8R1M6D3V9H2S7P5MC",
    "seq": 1,
    "start_seconds": 0.0,
    "duration_seconds": 2.9,
    "text": "Welcome to this short meditation—find a comfortable seat.",
    "created_at": "2026-05-09T06:17:02Z",
    "updated_at": "2026-05-09T06:17:02Z"
  },
  {
    "id": "ytc_01JH5F23D1M7Q3V9H2R7T0C9E",
    "transcript_id": "ytt_01J9Y9E0K8R1M6D3V9H2S7P5MC",
    "seq": 2,
    "start_seconds": 3.1,
    "duration_seconds": 4.5,
    "text": "Take a slow inhale through the nose, and exhale gently.",
    "created_at": "2026-05-09T06:17:03Z",
    "updated_at": "2026-05-09T06:17:03Z"
  },
  {
    "id": "ytc_01JH5F2A8D1M6Q3V9R2T5A0C0F",
    "transcript_id": "ytt_01J9Y9E0K8R1M6D3V9H2S7P5MC",
    "seq": 3,
    "start_seconds": 7.9,
    "duration_seconds": 4.0,
    "text": "Let your shoulders drop, and soften your jaw.",
    "created_at": "2026-05-09T06:17:03Z",
    "updated_at": "2026-05-09T06:17:03Z"
  },
  {
    "id": "ytc_01JH5F2H2S8H1D6K3R9T3A5C1G",
    "transcript_id": "ytt_01J9Y9E0K8R1M6D3V9H2S7P5MC",
    "seq": 4,
    "start_seconds": 12.2,
    "duration_seconds": 5.1,
    "text": "Notice any sounds around you without chasing them.",
    "created_at": "2026-05-09T06:17:04Z",
    "updated_at": "2026-05-09T06:17:04Z"
  },
  {
    "id": "ytc_01JH5F2Q0S6H2D9M5R1T6A2C2H",
    "transcript_id": "ytt_01J9Y9E0K8R1M6D3V9H2S7P5MC",
    "seq": 5,
    "start_seconds": 17.6,
    "duration_seconds": null,
    "text": "When your mind wanders, return to the breath.",
    "created_at": "2026-05-09T06:17:04Z",
    "updated_at": "2026-05-09T06:17:07Z"
  }
]