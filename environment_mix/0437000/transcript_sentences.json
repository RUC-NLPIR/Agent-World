[
  {
    "id": "gong_snt_01J9ZC8Y0R4H2M7T1Q6K3V9AZ1",
    "transcript_id": "gong_trx_01J9Y2Q4F7K3M8T1D6R0H5V9AZ",
    "call_id": "gong_call_01J4W8Q9R2T6H3K7M1N5P0V8ZA",
