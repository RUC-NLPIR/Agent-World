      "reference_answer": "{\"found\": true, \"row_number\": 3, \"row\": [\"lot-240305\", \"Line 2\", \"5.6%\", \"2.0%\", \"escalated\", \"chen.jie\", \"2024-03-20\", \"PartsCo\", \"press tonnage\"]}",
      "grading_rubric": {
        "success_criteria": [
          "A spreadsheet titled \"QMS Escalation Log 2024-03\" is created and its spreadsheet_id is returned by create_spreadsheet.",
          "Sheet1 in the new spreadsheet contains the header row and exactly the two escalated lots from sheet_dt: lot-240302 and lot-240305 with their listed fields.",
          "find_row for lot-240302 returns a matched row (not 'no match').",
          "find_row for lot-240305 returns a matched row (not 'no match')."
        ],
        "verified_tool_chain": [
          {
            "tool": "read_values",
            "args": {
              "sheet_id": "sheet_dt",
              "range_": "Sheet1"
            }
          },
          {
            "tool": "create_spreadsheet",
            "args": {
