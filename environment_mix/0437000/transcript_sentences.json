    "speaker_id": "spk_0",
    "start_ms": 12450,
    "end_ms": 17890,
    "text": "Thanks for making time—wanted to align on the renewal timeline and any blockers on security review.",
    "ordinal": 12,
    "confidence": 0.92,
    "created_at": "2026-01-14T10:22:41Z",
    "updated_at": "2026-01-14T10:23:10Z"
  },
  {
    "id": "gong_snt_01J9ZC9A6T2D7H1Q8M4K0V5N9QF",
    "transcript_id": "gong_trx_01J9Y2Q4F7K3M8T1D6R0H5V9AZ",
    "call_id": "gong_call_01J4W8Q9R2T6H3K7M1N5P0V8ZA",
    "workspace_id": "gong_ws_01J9A0H7W8Q5M2R1T6K3V9N0BP",
    "speaker_id": "spk_1",
    "start_ms": 17910,
    "end_ms": 24630,
    "text": "Sure—legal is done, but we’re waiting on the SOC 2 report and the data retention addendum.",
