    "name": "search_repos",
    "description": "Search GitHub repositories with filters (language, stars, pushed).",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string"
        },
        "min_stars": {
          "type": "integer",
          "minimum": 0
        },
        "pushed_after": {
          "type": "string",
