  {
    "id": "hnitm_01JCB2TH2Z0J8W9S6N2V3A7C1L",
    "hn_item_id": 42061530,
    "item_type": "story",
    "story_subtype": "ask_hn",
    "title": "Ask HN: Any good alternatives to Datadog for logs + APM?",
    "url": null,
    "text_html": "<p>We’re priced out of Datadog. Need logs, traces, decent alerting, and Terraform support. What should we evaluate?</p>",
    "by_user_id": "hnusr_01J9G7QBHR6B3G1V8K2Q6E7A9P",
    "time_posted_at": "2026-06-23T04:58:12Z",
    "parent_hn_item_id": null,
    "root_story_hn_item_id": null,
    "score_points": 401,
    "num_comments": 221,
    "status": "active",
    "last_synced_at": "2026-07-12T01:03:55Z",
    "created_at": "2026-06-23T04:59:40Z",
    "updated_at": "2026-07-12T01:03:55Z"
  },
  {
    "id": "hnitm_01JCB2TQ4W8E2K9M1R6Q3P7Y0V",
    "hn_item_id": 42061531,
    "item_type": "comment",
    "story_subtype": null,
    "title": null,
    "url": null,
    "text_html": "<p>We moved from Datadog to Grafana Cloud (Loki+Tempo). Biggest win was predictable pricing; biggest pain was dashboards parity.</p>",
    "by_user_id": "hnusr_01J9G7Q94D5WQ9E4H3R7M3S5K6",
    "time_posted_at": "2026-06-23T05:12:49Z",
    "parent_hn_item_id": 42061530,
    "root_story_hn_item_id": 42061530,
    "score_points": null,
    "num_comments": null,
    "status": "active",
    "last_synced_at": "2026-07-12T01:04:10Z",
    "created_at": "2026-06-23T05:13:21Z",
    "updated_at": "2026-07-12T01:04:10Z"
  },
  {
    "id": "hnitm_01JCB2TWK3V6Q2N8H7S1D0F5AZ",
    "hn_item_id": 42061540,
    "item_type": "comment",
    "story_subtype": null,
    "title": null,
    "url": null,
    "text_html": "<p>+1 Grafana Cloud. If you self-host, budget time for retention tuning; Loki costs can surprise you with chatty services.</p>",
    "by_user_id": "hnusr_01J9G7Q7YJ1G9Q3YB8S4Z9P2KQ",
    "time_posted_at": "2026-06-23T05:25:07Z",
    "parent_hn_item_id": 42061531,
    "root_story_hn_item_id": 42061530,
    "score_points": null,
    "num_comments": null,
    "status": "active",
    "last_synced_at": "2026-07-12T01:04:18Z",
    "created_at": "2026-06-23T05:26:00Z",
    "updated_at": "2026-07-12T01:04:18Z"
  },
  {
