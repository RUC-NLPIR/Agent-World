    "name": "Daily Revenue Digest to Email",
    "status": "active",
    "active": true,
    "nodes": [
      {
        "id": "n1",
        "name": "Cron",
        "type": "n8n-nodes-base.cron",
        "typeVersion": 1,
        "position": [
          200,
          240
        ],
        "parameters": {
          "triggerTimes": {
            "item": [
              {
                "mode": "everyDay",
                "hour": 7,
                "minute": 10
              }
            ]
          }
        }
      },
      {
        "id": "n2",
        "name": "Postgres",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2,
        "position": [
          440,
          240
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT date_trunc('day', now()) as day, sum(amount) as total_cents FROM payments WHERE created_at >= now() - interval '1 day';"
        }
      },
      {
        "id": "n3",
        "name": "Set",
        "type": "n8n-nodes-base.set",
        "typeVersion": 2,
        "position": [
          680,
          240
        ],
        "parameters": {
          "keepOnlySet": true,
          "values": {
            "string": [
              {
                "name": "subject",
                "value": "={{`Revenue digest - ${$json.day}`}}"
              },
              {
                "name": "body",
                "value": "={{`Total: $${($json.total_cents/100).toFixed(2)}`}}"
              }
            ]
          }
        }
      },
      {
        "id": "n4",
        "name": "SMTP",
        "type": "n8n-nodes-base.emailSend",
        "typeVersion": 2,
        "position": [
          920,
          240
        ],
        "parameters": {
          "subject": "={{$json.subject}}",
          "text": "={{$json.body}}",
          "toEmail": "finance@northwindpayments.com"
        }
      }
    ],
    "connections": {
      "Cron": {
        "main": [
          [
            {
              "node": "Postgres",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
