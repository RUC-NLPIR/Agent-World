    "resource_type": "alert_rule",
    "uid": "ar_api_5xx_burn",
    "numeric_id": 501,
    "name": null,
    "title": "API 5xx burn rate (30m/6h)",
    "folder_uid": "fld_sre_ops",
    "folder_title": "SRE / Ops",
    "type": null,
    "url": "https://grafana.northshore.example/alerting/grafana/ar_api_5xx_burn/view",
    "tags": [],
    "labels": {
      "env": "prod",
      "service": "api",
      "team": "sre",
      "severity": "page"
    },
    "is_default": false,
    "state": "normal",
    "spec": {
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "datasourceUid": "ds_prom_main",
          "model": {
            "expr": "sum(rate(http_requests_total{job=\"api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"api\"}[5m]))",
            "interval": "30s"
          }
        },
        {
          "refId": "B",
          "datasourceUid": "__expr__",
          "model": {
            "type": "reduce",
            "reducer": "last"
          }
        },
        {
          "refId": "C",
          "datasourceUid": "__expr__",
          "model": {
            "type": "threshold",
            "op": "gt",
            "value": 0.02
          }
        }
      ],
      "for": "5m",
      "noDataState": "NoData",
      "execErrState": "Error"
    },
